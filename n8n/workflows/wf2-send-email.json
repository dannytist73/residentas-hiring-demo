{
  "name": "WF2 - Send Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-email",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Receive Send Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "residentas-send-email",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_WEBHOOK_AUTH_CREDENTIAL_ID",
          "name": "Residentas Webhook Auth"
        }
      }
    },
    {
      "parameters": {
        "operation": "get",
        "base": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_BASE_ID",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Candidates",
          "mode": "name"
        },
        "id": "={{ $json.body.recordId }}"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000002",
      "name": "Get Candidate Row",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [450, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_WITH_AIRTABLE_CREDENTIAL_ID",
          "name": "Residentas Airtable"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "already-sent-check",
              "leftValue": "={{ $json.fields.Status }}",
              "rightValue": "Sent",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000003",
      "name": "Already Sent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "fromEmail": "REPLACE_WITH_YOUR_GMAIL_ADDRESS",
        "toEmail": "={{ $('Get Candidate Row').first().json.fields.Email }}",
        "subject": "={{ $('Get Candidate Row').first().json.fields['Drafted Email Subject'] }}",
        "emailFormat": "text",
        "text": "={{ $('Get Candidate Row').first().json.fields['Drafted Email Body'] }}"
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000004",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [850, 420],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_GMAIL_CREDENTIAL_ID",
          "name": "Residentas Gmail"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_BASE_ID",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Candidates",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $('Get Candidate Row').first().json.id }}",
            "Status": "Sent",
            "Sent At": "={{ $now.toISO() }}",
            "Send Triggered": false
          },
          "matchingColumns": ["id"],
          "schema": []
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000005",
      "name": "Mark Sent",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [1050, 420],
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_WITH_AIRTABLE_CREDENTIAL_ID",
          "name": "Residentas Airtable"
        }
      }
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0001-0001-0001-000000000006",
      "name": "WF2 Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [250, 520]
    },
    {
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_BASE_ID",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Candidates",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $('Get Candidate Row').first().json.id }}",
            "Status": "Failed",
            "Last Error": "={{ $json.execution.error.message }}"
          },
          "matchingColumns": ["id"],
          "schema": []
        }
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000007",
      "name": "Mark Failed",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [450, 520],
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_WITH_AIRTABLE_CREDENTIAL_ID",
          "name": "Residentas Airtable"
        }
      }
    }
  ],
  "connections": {
    "Receive Send Trigger": {
      "main": [[{"node": "Get Candidate Row", "type": "main", "index": 0}]]
    },
    "Get Candidate Row": {
      "main": [[{"node": "Already Sent?", "type": "main", "index": 0}]]
    },
    "Already Sent?": {
      "main": [
        [],
        [{"node": "Send Email", "type": "main", "index": 0}]
      ]
    },
    "Send Email": {
      "main": [[{"node": "Mark Sent", "type": "main", "index": 0}]]
    },
    "WF2 Error Trigger": {
      "main": [[{"node": "Mark Failed", "type": "main", "index": 0}]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
